# Loaded automatically by `pnpm build` (Vite runs it in production mode).
# Inlined into the bundle at build time.
#
# Deliberately empty: Firebase Hosting rewrites /api/** to the Cloud Run
# backend, so the browser only ever talks to its own origin. The routes already
# carry the /api prefix (backend app/routers/__init__.py), and the generated
# client concatenates base + path, so anything non-empty here would double the
# prefix or produce a protocol-relative "//api/..." URL.

VITE_API_BASE_URL=http://localhost:8080

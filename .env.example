# Billing (dedicated service account for the Budget API + BigQuery cost export).
# Needs roles/billing.viewer on the BILLING ACCOUNT (not the project), plus
# roles/bigquery.jobUser and roles/bigquery.dataViewer on the export dataset.
# Leave blank to disable — GET /billing/costs then returns 503.
BILLING_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
BILLING_SERVICE_ACCOUNT_PRIVATE_KEY=
BILLING_SERVICE_ACCOUNT_CLIENT_EMAIL=
BILLING_SERVICE_ACCOUNT_CLIENT_ID=
BILLING_SERVICE_ACCOUNT_AUTH_URI=
BILLING_SERVICE_ACCOUNT_TOKEN_URI=
BILLING_SERVICE_ACCOUNT_AUTH_PROVIDER_X509_CERT_URL=
BILLING_ACCOUNT_ID=
BILLING_TARGET_PROJECT_ID=
BILLING_EXPORT_DATASET=
BILLING_EXPORT_TABLE=
# Cache TTL for billing lookups (0 = query live on every request) and a hard
# per-query bytes-billed ceiling. Must be integers, not blank.
BILLING_CACHE_TTL_SECONDS=300
BILLING_MAX_BYTES_BILLED=1073741824